<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="teknofest_world">
    <include><uri>model://sun</uri></include>

    <!-- ================================================================== -->
    <!--  DUZ KATI ZEMIN (collision-only)                                   -->
    <!--  Dekoratif zemin mesh'i (zemin.dae) trimesh collision veriyor;     -->
    <!--  tekerler bu trimesh'te ~yuzeyde guvenilmez temas kurup PATINAJ    -->
    <!--  yapiyordu (476 kg govde kimildamiyordu). z=0'da genis duz bir     -->
    <!--  collision plane tekerlere HER ZAMAN saglam temas verir -> tutus.  -->
    <!--  Rampalar bunun UZERINDE kaldigindan tirmanis etkilenmez.          -->
    <!-- ================================================================== -->
    <model name="solid_ground">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="ground_col">
          <geometry><plane><normal>0 0 1</normal><size>500 500</size></plane></geometry>
          <surface>
            <friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction>
          </surface>
        </collision>
      </link>
    </model>

    <!-- ================================================================== -->
    <!--  FIZIK COZUCU (ODE)                                                -->
    <!--  476 kg arac + sert teker temasi (kp=1e6) icin varsayilan 50       -->
    <!--  iterasyon YETERSIZ: surtunme kuvveti LCP'de yakinsamaz, arka      -->
    <!--  tekerler bosa doner / arac surunur (rampayi cikamaz). Iterasyon   -->
    <!--  artirildi; agir aracin traksiyonu artik dogru hesaplanir.         -->
    <!-- ================================================================== -->
    <gravity>0 0 -9.81</gravity>
    <physics name="default_physics" type="ode" default="true">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>200</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
    <model name="teknofest_parkur_full">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        
        <visual name="v_zemin">
          <geometry><mesh><uri>model://karamuhafiz_base/meshes/zemin.dae</uri><scale>1 1 1</scale></mesh></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grass</name>
            </script>
          </material>
        </visual>
        <collision name="c_zemin">
          <geometry><mesh><uri>model://karamuhafiz_base/meshes/zemin.dae</uri><scale>1 1 1</scale></mesh></geometry>
          <!-- Zemin surtunmesi acikca yuksek: lastik ile birlesip agir araca yeterli
               traksiyon verir. SADECE friction; temas sertligi (kp) override EDILMEZ
               -> zemin Gazebo varsayilani (~1e13, sert) kalir, sertligi teker (kp=1e6)
               belirler. (kp'yi zeminde 1e6'ya cekmek araci ~0.14 m batiriyordu.) -->
          <surface>
            <friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction>
          </surface>
        </collision>

        <visual name="v_yol">
          <pose>0 0 0.01 0 0 0</pose>
          <geometry><mesh><uri>model://karamuhafiz_base/meshes/yol.dae</uri><scale>1 1 1</scale></mesh></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/DarkGrey</name>
            </script>
          </material>
        </visual>
        <collision name="c_yol">
          <pose>0 0 0.01 0 0 0</pose>
          <geometry><mesh><uri>model://karamuhafiz_base/meshes/yol.dae</uri><scale>1 1 1</scale></mesh></geometry>
          <surface>
            <friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction>
          </surface>
        </collision>
        
        <visual name="v_cizgiler">
          <pose>0 0 0.015 0 0 0</pose>
          <geometry><mesh><uri>model://karamuhafiz_base/meshes/cizgiler.dae</uri><scale>1 1 1</scale></mesh></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>

        <visual name="v_dik">
          <geometry><mesh><uri>model://karamuhafiz_base/meshes/dik_egim.dae</uri><scale>1 1 1</scale></mesh></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
        <collision name="c_dik">
          <geometry><mesh><uri>model://karamuhafiz_base/meshes/dik_egim.dae</uri><scale>1 1 1</scale></mesh></geometry>
          <!-- Dik rampa: tirmanis icin yuksek surtunme sart -->
          <surface>
            <friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction>
          </surface>
        </collision>

        <visual name="v_yan">
          <geometry><mesh><uri>model://karamuhafiz_base/meshes/yan_egim.dae</uri><scale>1 1 1</scale></mesh></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
        <collision name="c_yan">
          <geometry><mesh><uri>model://karamuhafiz_base/meshes/yan_egim.dae</uri><scale>1 1 1</scale></mesh></geometry>
          <surface>
            <friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction>
          </surface>
        </collision>

        <visual name="v_su">
          <geometry><mesh><uri>model://karamuhafiz_base/meshes/sudan_gecis.dae</uri><scale>1 1 1</scale></mesh></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Blue</name>
            </script>
          </material>
        </visual>
        <collision name="c_su">
          <geometry><mesh><uri>model://karamuhafiz_base/meshes/sudan_gecis.dae</uri><scale>1 1 1</scale></mesh></geometry>
        </collision>

        <visual name="v_kuka">
          <geometry><mesh><uri>model://karamuhafiz_base/meshes/kukalar.dae</uri><scale>1 1 1</scale></mesh></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Orange</name>
            </script>
          </material>
        </visual>
        <collision name="c_kuka">
          <geometry><mesh><uri>model://karamuhafiz_base/meshes/kukalar.dae</uri><scale>1 1 1</scale></mesh></geometry>
        </collision>

        <visual name="v_tabela">
          <geometry><mesh><uri>model://karamuhafiz_base/meshes/tabelalar.dae</uri><scale>1 1 1</scale></mesh></geometry>
        </visual>
        <collision name="c_tabela">
          <geometry><mesh><uri>model://karamuhafiz_base/meshes/tabelalar.dae</uri><scale>1 1 1</scale></mesh></geometry>
        </collision>

        <visual name="v_bariyer">
          <geometry><mesh><uri>model://karamuhafiz_base/meshes/bariyer.dae</uri><scale>1 1 1</scale></mesh></geometry>
        </visual>
        <collision name="c_bariyer">
          <geometry><mesh><uri>model://karamuhafiz_base/meshes/bariyer.dae</uri><scale>1 1 1</scale></mesh></geometry>
        </collision>

      </link>
    </model>
  </world>
</sdf>
